---
import BlogLayout from "../../../layouts/BlogLayout.astro";
import PostList from "../../../components/PostList.astro";
import { getPublishedPosts, tagSlug, type Post } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Map<string, { label: string; posts: Post[] }>();
  for (const post of posts) {
    for (const label of post.data.tags) {
      const slug = tagSlug(label);
      const tag = tags.get(slug) ?? { label, posts: [] };
      tag.posts.push(post);
      tags.set(slug, tag);
    }
  }
  return [...tags.entries()].map(([tag, value]) => ({ params: { tag }, props: value }));
}

interface Props {
  label: string;
  posts: Post[];
}

const { label, posts } = Astro.props;
---

<BlogLayout title={`Posts tagged ${label}`} description={`Published posts tagged ${label}.`}>
    <header class="page-intro blog-intro">
      <div class="page-heading">
        <h1>Posts tagged “{label}”</h1>
        <a class="text-link" href="/blog/">All field notes</a>
      </div>
    </header>
    <section class="blog-index inner-content" aria-label={`Posts tagged ${label}`}>
      <PostList {posts} emptyMessage={`No published posts are tagged ${label}.`} />
    </section>
</BlogLayout>
