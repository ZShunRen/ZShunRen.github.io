---
import BlogArticle from "../../components/BlogArticle.astro";
import PostList from "../../components/PostList.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getCtfEvents, getPublishedPosts, postSlug, type CtfEvent, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const events = getCtfEvents(posts);
  return [
    ...posts.map((post) => ({ params: { slug: postSlug(post) }, props: { kind: "post", post } })),
    ...events.map((event) => ({ params: { slug: event.slug }, props: { kind: "event", event } })),
  ];
}

type Props = { kind: "post"; post: Post } | { kind: "event"; event: CtfEvent };
const props = Astro.props;
---

{props.kind === "post" ? <BlogArticle post={props.post} /> : (
  <BlogLayout title={props.event.label} description={`Challenge writeups from ${props.event.label}.`}>
    <header class="page-intro blog-intro">
      <div class="page-heading">
        <h1>{props.event.label}</h1>
        <p>{props.event.posts.length} {props.event.posts.length === 1 ? "writeup" : "writeups"}</p>
        <a class="text-link" href="/blog/">Back to field notes</a>
      </div>
    </header>
    <section class="blog-index inner-content" aria-label={`Writeups from ${props.event.label}`}>
      <PostList posts={props.event.posts} />
    </section>
  </BlogLayout>
)}
