---
import BaseLayout from "../layouts/BaseLayout.astro";
import SceneryMotion from "../components/SceneryMotion";
import JourneyGround from "../components/home/JourneyGround.astro";
import Summit from "../components/home/Summit.astro";
import Forest from "../components/home/Forest.astro";
import CtfRankings from "../components/home/CtfRankings.astro";
import About from "../components/home/About.astro";
import Contact from "../components/home/Contact.astro";
import profile from "../data/profile.json";
---

<BaseLayout title={profile.name} description={profile.description} bodyClass="home" current="home">
  <main id="main">
    <JourneyGround />
    <Summit />
    <Forest />
    <CtfRankings />
    <About />
    <Contact />
  </main>
  <SceneryMotion client:load />
</BaseLayout>
