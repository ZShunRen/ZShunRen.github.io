---
import BaseLayout from "../layouts/BaseLayout.astro";
import profile from "../data/profile.json";
---

<BaseLayout title="About me" description={profile.description} current="about">
  <main id="main">
    <header class="page-intro">
      <div class="page-heading">
        <h1>About me</h1>
        <a class="text-link" href="/">
          Back to the trail
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </header>
    <section class="inner-content reading-surface">
      <blockquote>
        “The only man who never makes mistakes is the man who never does anything.”
        <cite>— Theodore Roosevelt</cite>
      </blockquote>
      <div class="bio-grid">
        <img class="portrait" src="/images/me.jpg" alt={profile.name} width="260" height="330" loading="lazy" />
        <div>
          <h3>Student &amp; Infosec Enthusiast</h3>
          {profile.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <dl class="personal-details">
            <div><dt>Website</dt><dd><a href="https://zshunren.github.io/">zshunren.github.io</a></dd></div>
            <div><dt>City</dt><dd>Singapore</dd></div>
            <div><dt>Age</dt><dd>20</dd></div>
            <div><dt>Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
          </dl>
        </div>
      </div>
      <div class="education">
        <h2>Educational Qualifications</h2>
        <article class="education-row">
          <img src="/images/ACJC_crest.png" alt="Anglo-Chinese Junior College crest" width="64" height="72" loading="lazy" />
          <div>
            <h3>Anglo-Chinese Junior College</h3>
            <p class="date">2019-2020</p>
            <p>I took 3H2 1H1 PCME for my GCE "A"-levels.</p>
            <p>I attained 89 RP.</p>
          </div>
        </article>
        <article class="education-row">
          <img src="/images/scss_crest.png" alt="Swiss Cottage Secondary School crest" width="64" height="72" loading="lazy" />
          <div>
            <h3>Swiss Cottage Secondary School</h3>
            <p class="date">2015-2018</p>
            <p>I took the triple science subject combination for my "O"-levels.</p>
            <p>I attained 9 raw for my L1R5.</p>
          </div>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
