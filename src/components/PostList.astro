---
import type { BlogEntry, Post } from "../lib/posts";
import PostRow from "./PostRow.astro";
import { formatPostDate } from "../lib/posts";

interface Props {
  posts?: Post[];
  entries?: BlogEntry[];
  emptyMessage?: string;
  headingLevel?: "h2" | "h3";
}

const {
  posts = [],
  entries = posts.map((post): BlogEntry => ({ kind: "post", post })),
  emptyMessage = "No published posts yet. New field notes will appear here.",
  headingLevel: Heading = "h2",
} = Astro.props;
---

{
  entries.length ? (
    <div class="post-list">
      {entries.map((entry) => entry.kind === "event" ? (
        <article class="post-row">
          <div class="post-meta">
            <span>Latest writeup <time datetime={entry.event.date.toISOString()}>{formatPostDate(entry.event.date)}</time></span>
            <span>CTF</span>
            <span>{entry.event.posts.length} writeups</span>
          </div>
          <Heading><a href={`/blog/${entry.event.slug}/`}>{entry.event.label}</a></Heading>
          <p>Browse {entry.event.posts.length} challenge writeups from {entry.event.label}.</p>
        </article>
      ) : <PostRow post={entry.post} headingLevel={Heading} />)}
    </div>
  ) : (
    <div class="empty-state">
      <h2>The notebook is quiet for now.</h2>
      <p>{emptyMessage}</p>
      <a class="text-link" href="/#ctf-rankings">Explore my CTF rankings</a>
    </div>
  )
}
