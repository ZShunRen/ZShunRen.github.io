---
import type { Post } from "../lib/posts";
import { formatPostDate, postSlug, tagSlug } from "../lib/posts";

interface Props {
  posts: Post[];
  emptyMessage?: string;
}

const {
  posts,
  emptyMessage = "No published posts yet. New field notes will appear here.",
} = Astro.props;
---

{
  posts.length ? (
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-row">
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
            <span>{post.data.category === "ctf" ? "CTF" : "Work"}</span>
          </div>
          <h2><a href={`/blog/${postSlug(post)}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="Tags">
              {post.data.tags.map((tag) => (
                <li><a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a></li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <h2>The notebook is quiet for now.</h2>
      <p>{emptyMessage}</p>
      <a class="text-link" href="/#ctf-rankings">Explore my CTF rankings</a>
    </div>
  )
}
