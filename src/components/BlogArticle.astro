---
import { render } from "astro:content";
import BlogLayout from "../layouts/BlogLayout.astro";
import { formatPostDate, ctfSlug, tagSlug, type Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  article
>
    <header class="page-intro article-intro">
      <div class="page-heading">
        <p class="article-meta">
          <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{post.data.category === "ctf" ? "CTF" : "Work"}</span>
          {post.data.category === "ctf" && post.data.ctfName && (
            <a href={`/blog/${ctfSlug(post.data.ctfName)}/`}>{post.data.ctfName}</a>
          )}
        </p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <a class="text-link" href="/blog/">Back to field notes</a>
      </div>
    </header>
    <div class="article-layout inner-content">
      {
        headings.length > 1 && (
          <nav class="article-toc" aria-label="On this page">
            <h2>On this page</h2>
            <ol>
              {headings.filter(({ depth }) => depth === 2 || depth === 3).map((heading) => (
                <li class={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </nav>
        )
      }
      <article class="article-paper">
        {
          post.data.cover && (
            <figure class="article-cover">
              <img
                src={post.data.cover}
                alt={post.data.coverAlt ?? `${post.data.title} cover image`}
                width="1200"
                height="675"
              />
            </figure>
          )
        }
        <div class="prose"><Content /></div>
        {
          post.data.tags.length > 0 && (
            <footer class="article-tags">
              <span>Filed under</span>
              <ul class="tag-list" aria-label="Tags">
                {post.data.tags.map((tag) => (
                  <li><a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a></li>
                ))}
              </ul>
            </footer>
          )
        }
      </article>
    </div>
</BlogLayout>
