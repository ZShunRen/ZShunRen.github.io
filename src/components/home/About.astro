        <div class="reading-surface">
          <h2 id="about-title">About me</h2>
          <blockquote>
            “The only man who never makes mistakes is the man who never does anything.”<cite>— Theodore Roosevelt</cite>
          </blockquote>
          <div class="bio-grid">
            <img
              class="portrait"
              src="/images/me.jpg"
              alt="Shun Ren"
              width="260"
              height="330"
              loading="lazy"
            />
            <div>
              <h3>Nerdy guy, sometimes does cybersec and swe stuff.</h3>
              {profile.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              <dl class="personal-details">
